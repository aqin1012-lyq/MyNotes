.res { display: flex; gap: 10px; align-items: flex-start; padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 14px; }
.res:last-child { border-bottom: 0; }
.res-body { flex: 1; min-width: 0; }
.ck-box { flex-shrink: 0; width: 18px; height: 18px; margin-top: 2px; border: 1.5px solid var(--accent); border-radius: 5px; font-size: 13px; line-height: 15px; text-align: center; color: var(--accent-ink); box-sizing: border-box; }
.res.done .ck-box { background: var(--accent); }
